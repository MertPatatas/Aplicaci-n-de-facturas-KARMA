# API
PORT=3001
DATA_DIR=./data
TZ_NEGOCIO=Europe/Madrid

# Token que debe enviar n8n en la cabecera x-ingest-token
INGEST_TOKEN=cambia-este-token

# Opcional: con clave, la extraccion y el asistente usan el modelo.
# Sin clave funcionan el lector por reglas y el asistente por patrones.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# n8n (solo para docker-compose)
N8N_ENCRYPTION_KEY=cambia-esta-clave
API_URL_DESDE_N8N=http://api:3001
